---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AskPanel from '../components/AskPanel.astro';
import { portfolio } from '../data/portfolio';

const featured = portfolio.projects.filter(project => project.featured);
const archive = portfolio.projects.filter(project => !project.featured);
---

<BaseLayout title={`${portfolio.name} · Profile`} description={portfolio.tagline}>
  <Header />
  <main id="main-content" class="profile">
    <section class="profile-intro" aria-labelledby="profile-title">
      <div class="intro-copy">
        <p class="pixel-label">THE PROFILE</p>
        <h1 id="profile-title">{portfolio.name}</h1>
        <p class="role">{portfolio.title}</p>
        <p class="intro-summary">{portfolio.tagline}</p>
        <div class="intro-links"><a class="solid-link" href="/explore/">Explore the Garden hall <span aria-hidden="true">↗</span></a><a href="#projects">Read the work <span aria-hidden="true">↓</span></a></div>
      </div>
      <a href="/explore/" class="hall-preview" aria-label="Enter the Garden hall Game">
        <img src="/art/garden-hall.png" alt="Sunlit stone, ferns, and timber in the 16-bit Garden hall." width="1536" height="1024" />
        <span class="preview-caption"><span aria-hidden="true">◆</span> A little world to explore <span aria-hidden="true">↗</span></span>
      </a>
    </section>

    <p class="preview-notice"><span class="notice-dot" aria-hidden="true"></span> Local preview. The content below is made up so you can test the layout and flow.</p>

    <div class="profile-body">
      <aside class="profile-directory">
        <nav aria-label="Profile sections">
          <p class="pixel-label">ON THIS PAGE</p>
          <a href="#about">About</a><a href="#experience">Experience</a><a href="#projects">Featured projects</a><a href="#archive">Project archive</a><a href="#skills">Skills & education</a><a href="#ask">Ask about Trevor</a><a href="#contact">Links & contact</a>
        </nav>
        <p class="directory-note">The same evidence is available in the Game. Read in any order.</p>
      </aside>

      <div class="profile-content">
        <section id="about" class="reading-section" aria-labelledby="about-title">
          <p class="pixel-label">ABOUT</p><h2 id="about-title">A bit of context.</h2>
          <div class="prose">{portfolio.about.map(paragraph => <p>{paragraph}</p>)}</div>
        </section>

        <section id="experience" class="reading-section" aria-labelledby="experience-title">
          <div class="section-heading"><div><p class="pixel-label">EXPERIENCE</p><h2 id="experience-title">The work behind the work.</h2></div><span class="section-meta">{portfolio.experience.length} records</span></div>
          <div class="experience-list">{portfolio.experience.map(record => <article id={record.id} class="experience-record">
            <p class="record-period">{record.period}</p>
            <div><h3>{record.title}</h3><p class="record-organization">{record.organization}</p><p>{record.summary}</p><ul>{record.bullets.map(bullet => <li>{bullet}</li>)}</ul></div>
          </article>)}</div>
        </section>

        <section id="projects" class="reading-section" aria-labelledby="projects-title">
          <div class="section-heading"><div><p class="pixel-label">FEATURED PROJECTS</p><h2 id="projects-title">Things built, taken apart,<br />and built again.</h2></div></div>
          <div class="project-list">{featured.map(project => <article id={project.id} class="project-card">
            <div class="project-heading"><h3><a href={`/projects/${project.id}/`}>{project.title}</a></h3><span aria-hidden="true">↗</span></div>
            <p>{project.summary}</p><ul class="tags" aria-label="Project technologies">{project.tags.map(tag => <li>{tag}</li>)}</ul><a class="detail-link" href={`/projects/${project.id}/`}>Read project details <span aria-hidden="true">→</span></a>
          </article>)}</div>
        </section>

        <section id="archive" class="reading-section" aria-labelledby="archive-title">
          <p class="pixel-label">PROJECT ARCHIVE</p><h2 id="archive-title">More from the workbench.</h2>
          <div class="archive-list">{archive.map(project => <article id={project.id}><div><h3><a href={`/projects/${project.id}/`}>{project.title}</a></h3><p>{project.summary}</p></div><a href={`/projects/${project.id}/`} aria-label={`Read ${project.title}`}><span aria-hidden="true">↗</span></a></article>)}</div>
          {archive.length === 0 && <p>More project notes will appear here.</p>}
        </section>

        <section id="skills" class="reading-section" aria-labelledby="skills-title">
          <p class="pixel-label">SKILLS & EDUCATION</p><h2 id="skills-title">Tools and foundations.</h2>
          <ul class="skills-list">{portfolio.skills.map(skill => <li>{skill}</li>)}</ul>
          <div id="education" class="education-list">{portfolio.education.map(record => <article id={record.id}><p class="record-period">{record.period}</p><h3>{record.title}</h3><p class="record-organization">{record.institution}</p><p>{record.summary}</p></article>)}</div>
        </section>

        <section id="ask" class="reading-section ask-section" aria-labelledby="ask-title">
          <p class="pixel-label">GROUNDED Q&A</p><h2 id="ask-title">Ask about the work.</h2><p class="ask-intro">Try a question, follow the evidence links, or paste a job description to test the flow.</p><AskPanel id="profile-ask" />
        </section>

        <section id="contact" class="reading-section" aria-labelledby="contact-title">
          <p class="pixel-label">LINKS & CONTACT</p><h2 id="contact-title">The usual places.</h2>
          <p>These are preview links. Contact details and a finished resume will be added with the real content.</p>
          <div id="preview-links" class="contact-links"><a href={portfolio.links.github}>GitHub <span aria-hidden="true">↗</span></a><a href={portfolio.links.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a><a href={portfolio.links.contact}>Contact <span aria-hidden="true">↗</span></a><a href={portfolio.links.resume}>Resume <span aria-hidden="true">↓</span></a></div>
        </section>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .profile{max-width:1240px;margin:auto;padding:62px 42px 80px;color:#203a31;font-family:'IBM Plex Sans',sans-serif}.profile-intro{display:grid;grid-template-columns:1.08fr 1fr;gap:58px;align-items:center;margin-bottom:35px}.pixel-label{font:8px/1.9 'Press Start 2P',monospace;letter-spacing:.08em;color:#617459;margin:0 0 18px}.intro-copy h1{font-size:clamp(35px,4.4vw,58px);font-weight:500;line-height:1.1;letter-spacing:-.04em;margin:0 0 18px}.role{font-size:20px;margin:0 0 15px;font-weight:500}.intro-summary{font-size:19px;line-height:1.6;color:#59695f;max-width:460px}.intro-links{display:flex;flex-wrap:wrap;gap:22px;align-items:center;margin-top:28px;font-size:14px}.intro-links a{text-decoration:none}.intro-links span{margin-left:9px}.solid-link{background:#25483d;color:#f2f3de;padding:13px 17px;border:1px solid #25483d;box-shadow:3px 3px #bac6ad}.hall-preview{display:block;position:relative;border:4px solid #d2d7ba;outline:1px solid #6f8a75;box-shadow:8px 8px #dae0d0;text-decoration:none;overflow:hidden;aspect-ratio:1.25}.hall-preview img{width:100%;height:100%;object-fit:cover;object-position:center;image-rendering:pixelated;display:block}.preview-caption{display:flex;align-items:center;gap:10px;position:absolute;left:0;right:0;bottom:0;background:#173b31ed;color:#e7ecd8;padding:13px 18px;font-size:12px}.preview-caption span:last-child{margin-left:auto}.preview-notice{display:flex;gap:12px;align-items:center;border-top:1px solid #d4ddcc;border-bottom:1px solid #d4ddcc;padding:16px 0;color:#60705e;font-size:13px;margin:40px 0 55px}.notice-dot{height:6px;width:6px;flex-shrink:0;background:#758c54}.profile-body{display:grid;grid-template-columns:190px minmax(0,1fr);gap:70px}.profile-directory nav{position:sticky;top:30px;display:flex;flex-direction:column;align-items:flex-start;gap:15px}.profile-directory nav .pixel-label{margin-bottom:5px}.profile-directory a{font-size:14px;text-decoration:none;color:#52654f}.profile-directory a:hover{text-decoration:underline;text-underline-offset:5px}.directory-note{font-size:12px;color:#7b8574;line-height:1.7;max-width:155px;margin-top:35px}.reading-section{scroll-margin-top:30px;margin-bottom:66px;padding-bottom:52px;border-bottom:1px solid #d4ddcc}.reading-section:last-child{border:0;margin-bottom:0;padding-bottom:0}.reading-section h2{font-size:clamp(25px,3vw,34px);font-weight:500;letter-spacing:-.025em;line-height:1.25;margin:0 0 25px}.reading-section h3{font-size:21px;font-weight:500;margin:0 0 8px;letter-spacing:-.02em}.reading-section p,.reading-section li{font-size:16px;line-height:1.75}.reading-section p{margin:0 0 16px}.reading-section .pixel-label{font-size:8px;line-height:1.9;margin-bottom:15px}.prose{max-width:710px;color:#526054}.section-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:20px}.section-meta{font-size:12px;color:#73816b;white-space:nowrap;margin-top:9px}.experience-record{display:grid;grid-template-columns:120px minmax(0,1fr);gap:28px;padding:24px 0;border-top:1px solid #dce2d3;scroll-margin-top:35px}.experience-record:first-child{padding-top:8px;border-top:0}.experience-record:last-child{padding-bottom:0}.reading-section .record-period{font-size:12px;color:#728168;margin-top:5px}.reading-section .record-organization{font-size:14px;color:#687b60;margin-bottom:15px}.experience-record ul{padding-left:19px;color:#526054}.experience-record li{margin-bottom:7px}.project-list{display:grid;gap:18px}.project-card{border:1px solid #cbd7c5;background:#fafcf6;padding:27px;box-shadow:4px 4px #e0e7d8;scroll-margin-top:30px}.project-heading{display:flex;justify-content:space-between;gap:18px;align-items:baseline}.project-heading a{text-decoration:none}.project-heading>span{color:#778768;font-size:23px}.project-card p{color:#65705d}.tags{display:flex;flex-wrap:wrap;list-style:none;gap:8px;padding:0;margin:18px 0 24px}.tags li{font-size:11px;background:#edf1e5;border:1px solid #d8dfc9;color:#65745d;padding:3px 9px;line-height:1.6}.detail-link{font-size:13px;font-weight:500;text-underline-offset:5px}.detail-link span{padding-left:8px}.archive-list article{display:flex;align-items:center;justify-content:space-between;gap:25px;border-top:1px solid #dce2d3;padding:23px 0;scroll-margin-top:30px}.archive-list h3{font-size:19px}.archive-list h3 a{text-decoration:none}.archive-list p{font-size:14px;color:#68755f;margin:0}.archive-list article>a{font-size:24px;text-decoration:none}.skills-list{list-style:none;padding:0;display:flex;flex-wrap:wrap;gap:9px;margin-bottom:34px}.skills-list li{background:#e8efdf;border-left:3px solid #8ba175;padding:7px 12px;font-size:14px;line-height:1.5}.education-list{display:grid;gap:20px;scroll-margin-top:30px}.education-list article{padding-top:23px;border-top:1px solid #dce2d3;scroll-margin-top:30px}.education-list .record-period{margin-top:0}.education-list h3{font-size:19px}.ask-intro{color:#677660}.contact-links{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px}.contact-links a{border:1px solid #b5c7aa;padding:10px 15px;text-decoration:none;font-size:14px}.contact-links span{margin-left:12px}a:focus-visible{outline:3px solid #a18547;outline-offset:5px}a:hover{color:#8b713d}.solid-link:hover{color:#fff;background:#35614e}
  @media(max-width:1000px){.profile{padding:45px 28px 65px}.profile-intro{gap:32px}.profile-body{grid-template-columns:155px minmax(0,1fr);gap:35px}.experience-record{grid-template-columns:1fr;gap:4px}.reading-section{padding-bottom:40px;margin-bottom:48px}.hall-preview{aspect-ratio:1}}
  @media(max-width:700px){.profile{padding:34px 20px 50px}.profile-intro{grid-template-columns:1fr;gap:32px}.hall-preview{aspect-ratio:1.7;max-width:100%}.profile-body{display:block}.profile-directory nav{position:static;flex-direction:row;flex-wrap:wrap;gap:12px 20px;margin:0 0 35px}.profile-directory nav .pixel-label{width:100%;margin:0}.directory-note{display:none}.preview-notice{margin:32px 0;font-size:12px}.intro-links{gap:20px}.intro-summary{font-size:17px}.role{font-size:18px}.profile-content h2 br{display:none}.project-card{padding:20px}.section-meta{display:none}.reading-section p,.reading-section li{font-size:15px}.reading-section .pixel-label{font-size:7px}.reading-section .tags li{font-size:11px}.reading-section .skills-list li{font-size:13px}.contact-links a{padding:9px 12px}}
</style>
