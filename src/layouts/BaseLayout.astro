---
import '../styles/global.css';
interface Props { title?: string; description?: string; page?: string }
const { title = 'Trevor Santiago', description = 'Trevor Santiago builds AI applications, semantic retrieval workflows, and cloud services.', page = 'profile' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- Intentional in Production too: the Portfolio is shared by link, without search indexing. -->
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/press-start-2p.ttf" as="font" type="font/ttf" crossorigin />
    <title>{title}</title>
  </head>
  <body data-page={page}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
