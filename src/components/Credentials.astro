---
import { portfolio } from '../data/portfolio';
---
<div class="credentials">
  <section id="certifications" aria-labelledby="certifications-title">
    <h3 id="certifications-title">Certifications</h3>
    <ul>{portfolio.certifications.map(record => <li id={record.id}><strong>{record.title}</strong><span>{record.organization} · {record.period}</span></li>)}</ul>
  </section>
  <section id="recognition" aria-labelledby="recognition-title">
    <h3 id="recognition-title">Recognition</h3>
    <ul>{portfolio.recognition.map(record => <li id={record.id}><strong>{record.title}</strong><span>{record.organization} · {record.period}</span></li>)}</ul>
  </section>
</div>
<style>
  .credentials{margin-top:28px}.credentials section{border-top:1px solid #c2cdb5;padding-top:22px;margin-top:22px;scroll-margin-top:30px}.credentials h3{font-size:19px;font-weight:500;line-height:1.4;margin:0 0 18px}.credentials ul{padding:0;margin:0;list-style:none;display:grid;gap:16px}.credentials li{line-height:1.6;scroll-margin-top:30px}.credentials strong{display:block;font-weight:500;font-size:15px}.credentials span{display:block;font-size:13px;color:#687b60}
</style>
