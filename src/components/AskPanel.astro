---
import AskDemo from './AskDemo.astro';
interface Props { id?: string }
const { id = 'ask' } = Astro.props;
const showDemo = import.meta.env.QA_DEMO === '1' && import.meta.env.VERCEL_ENV !== 'production';
---

{showDemo ? <AskDemo id={id} /> : <section class="ask-construction" aria-labelledby={`${id}-title`}>
  <p class="construction-label">UNDER CONSTRUCTION</p>
  <h3 id={`${id}-title`}>AI Q&A is on the way.</h3>
  <p>I'm building and testing a Q&A that answers questions about my work and links to the supporting evidence.</p>
  <p>For now, you can read the projects and experience directly or get in touch.</p>
  <div class="construction-links"><a href="/profile/#projects">Browse projects <span aria-hidden="true">↗</span></a><a href="/profile/#contact">Get in touch <span aria-hidden="true">↗</span></a></div>
</section>}

<style>
  .ask-construction { padding:24px; border:1px solid #bfcbb2; background:#f4f7ec; box-shadow:4px 4px #dde4d0; color:#334638; font-family:'IBM Plex Sans',sans-serif; }
  .construction-label { font:7px/1.9 'Press Start 2P',monospace; letter-spacing:.06em; color:#6d7b56; margin:0 0 16px; }
  h3 { font-size:23px; line-height:1.3; font-weight:500; margin:0 0 16px; }
  p:not(.construction-label) { max-width:60ch; font-size:15px; line-height:1.75; margin:0 0 16px; }
  .construction-links { display:flex; flex-wrap:wrap; gap:14px 24px; padding-top:8px; }
  a { font-size:14px; line-height:1.7; color:#395b46; text-underline-offset:4px; }
  a span { margin-left:6px; }
  a:hover { color:#8b743f; }
  a:focus-visible { outline:3px solid #8b743f; outline-offset:4px; }
  @media(max-width:600px) { .ask-construction { padding:20px; } h3 { font-size:21px; } p:not(.construction-label) { font-size:14px; } }
</style>
