---
import EvidenceContent from './EvidenceContent.astro';
import { exhibits } from '../data/portfolio';
interface Props { hidden?: boolean; id?: string }
const { hidden = false, id = 'main-content' } = Astro.props;
---
  <main id={id} class="game-shell" hidden={hidden}>
    <header class="game-header"><a class="brand" href="/"><span class="crest" aria-hidden="true">T</span><span>Trevor Santiago</span></a><h1>THE GARDEN HALL</h1><nav aria-label="Primary navigation"><a href="/">Home</a><a href="/profile/">Profile ↗</a></nav></header>
    <div class="game-stage">
      <div id="hall" tabindex="0" role="group" aria-label="Garden hall. Move with WASD or arrow keys, press E near an exhibit to inspect it."></div>
      <div class="game-loading" role="status"><img src="/art/garden-hall.png" alt="" width="1536" height="1024" /><span>Opening the hall…</span></div>
      <div class="game-failure" hidden><h2>The hall couldn't load.</h2><p>Try reloading, or read the same content in the Profile.</p><a class="pixel-button" href="/profile/">Read the Profile ↗</a></div>
      <div class="touch-controls" aria-label="Touch movement controls"><div class="dpad"><button data-direction="0,-1" class="up" aria-label="Move up">↑</button><button data-direction="-1,0" class="left" aria-label="Move left">←</button><button data-direction="1,0" class="right" aria-label="Move right">→</button><button data-direction="0,1" class="down" aria-label="Move down">↓</button></div><button data-touch-interact disabled aria-label="Inspect nearby exhibit">E</button></div>
    </div>
    <div class="game-toolbar"><p class="keyboard-help"><kbd>W A S D</kbd> / <kbd>↑ ← ↓ →</kbd> Walk <span>·</span> <kbd>E</kbd> Inspect</p><button class="nearby-button" data-interact disabled><span class="keycap">E</span><span data-nearby-label>Walk to an exhibit</span></button><details class="exhibit-directory"><summary>Exhibits <span aria-hidden="true">↑</span></summary><nav aria-label="Exhibit directory">{exhibits.map(exhibit => <button data-open-exhibit={exhibit.id}>{exhibit.label}<span aria-hidden="true">↗</span></button>)}</nav></details></div>
    <p class="game-caption">Preview · Explore the work <span>Click a marker to walk to it.</span></p>
    <noscript><p class="no-script">The Game needs JavaScript. <a href="/profile/">Read the complete Profile instead.</a></p></noscript>
  </main>
  <div class="evidence-backdrop" hidden>
    <section class="evidence-dialog" role="dialog" aria-modal="true" tabindex="-1">
      <div class="scroll-rod" aria-hidden="true"></div>
      <div class="evidence-paper">
        <header class="panel-controls"><span>EVIDENCE FROM THE HALL</span><button data-close-panel aria-label="Close evidence panel">×</button></header>
        <div class="evidence-reader">{exhibits.map(exhibit => <div data-evidence={exhibit.id} hidden><EvidenceContent exhibit={exhibit} /></div>)}</div>
        <footer class="panel-footer"><span>Game paused</span><button data-close-panel>Return to the hall <kbd>Esc</kbd></button></footer>
      </div>
      <div class="scroll-rod" aria-hidden="true"></div>
    </section>
  </div>
  <script type="application/json" id="exhibit-manifest" set:html={JSON.stringify(exhibits).replace(/</g, '\\u003c')} />
<style>
  .game-shell{height:100svh;min-height:460px;display:flex;flex-direction:column;overflow:hidden;background:#20392e;color:#d7e2c8}.game-header{min-height:64px;display:flex;justify-content:space-between;align-items:center;gap:20px;padding:12px 25px;border-bottom:3px solid #768a6e;background:#203d30}.game-header .brand{font-size:13px}.game-header h1{font:8px/1.7 var(--display);letter-spacing:.12em;margin:0;color:#cad9b4}.game-header nav{display:flex;gap:22px;font-size:13px}.game-header nav a{text-decoration:none}.game-stage{flex:1;min-height:0;position:relative;background:#253b2e}#hall{width:100%;height:100%;outline-offset:-4px}#hall :global(canvas){display:block;image-rendering:pixelated}.game-loading{position:absolute;inset:0;display:grid;place-items:center;background:#22392d}.game-loading img{position:absolute;inset:0;height:100%;width:100%;object-fit:cover;opacity:.35;image-rendering:pixelated}.game-loading span{position:relative;font:9px/1.8 var(--display);padding:25px;background:#233d31d9}.game-failure{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:30px;text-align:center;background:#20392eed}.game-failure h2{font:14px/2 var(--display)}.game-toolbar{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:13px 25px;border-top:3px solid #7f916f;background:#253f32;min-height:65px}.keyboard-help{font-size:12px;white-space:nowrap;margin:0;color:#bccbad}.keyboard-help span{margin:0 12px}kbd{font-family:var(--body);border:1px solid #7e9475;padding:3px 5px;color:#dce8c9;white-space:nowrap}.nearby-button{display:flex;align-items:center;gap:14px;background:#d9e2bd;color:#294434;border:2px solid #aebf98;box-shadow:3px 3px #172b20;padding:8px 14px;font-size:13px}.nearby-button:disabled{background:#324e3b;color:#9cad88;border-color:#5f7754}.keycap{font:9px var(--display);border:1px solid currentColor;padding:5px}.exhibit-directory{position:relative;min-width:110px;font-size:12px}.exhibit-directory summary{cursor:pointer;list-style:none;border:1px solid #8c9f7e;padding:11px 14px}.exhibit-directory summary span{float:right;margin-left:14px}.exhibit-directory nav{position:absolute;bottom:calc(100% + 12px);right:0;width:260px;max-height:60svh;overflow:auto;background:#f0f2db;color:#2c4737;border:3px solid #99ab80;box-shadow:5px 5px #172b20;z-index:10;padding:9px}.exhibit-directory nav button{display:flex;justify-content:space-between;width:100%;padding:12px 10px;border:0;border-bottom:1px solid #ced7b9;background:transparent;text-align:left;font-size:13px}.exhibit-directory nav button:hover{background:#dce7c6}.game-caption{display:flex;justify-content:space-between;gap:20px;margin:0;padding:5px 25px 7px;background:#1f372b;color:#a4b593;font-size:10px}.touch-controls{display:none;position:absolute;left:18px;right:18px;bottom:20px;justify-content:space-between;align-items:flex-end;pointer-events:none}.touch-controls button{pointer-events:auto;touch-action:none;user-select:none;background:#294a38dc;border:2px solid #afbd95;color:#e7ecd5;font-size:22px;width:48px;height:48px;box-shadow:3px 3px #192c20}.touch-controls button:active{background:#729069}.touch-controls button:disabled{opacity:.45}.dpad{display:grid;grid-template-columns:repeat(3,48px);grid-template-rows:repeat(3,48px);gap:3px}.up{grid-area:1/2}.left{grid-area:2/1}.right{grid-area:2/3}.down{grid-area:3/2}.no-script{position:absolute;inset:100px 20px auto;padding:30px;background:#f0f2db;color:#203a31;z-index:20}
  .evidence-backdrop{position:fixed;inset:0;z-index:50;background:#101f19b8;backdrop-filter:blur(2px);display:flex;align-items:center;justify-content:center;padding:30px}.evidence-dialog{width:min(720px,100%);outline:none;filter:drop-shadow(10px 12px 0 #10211966)}.scroll-rod{height:24px;background:#8e663a;border:4px solid #3e422b;border-top-color:#c1a772;position:relative;box-shadow:inset 0 -5px #654c2f}.scroll-rod::before,.scroll-rod::after{content:'';position:absolute;top:-8px;width:15px;height:32px;border:4px solid #3e422b;background:#b2935e}.scroll-rod::before{left:-7px}.scroll-rod::after{right:-7px}.evidence-paper{margin:0 12px;background:#eef0d5;border-left:4px solid #c5cea5;border-right:4px solid #c5cea5;max-height:calc(100svh - 110px);display:flex;flex-direction:column;color:#334638}.panel-controls{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:16px 30px 12px;border-bottom:1px solid #d1d4b6}.panel-controls>span{font:6px/1.8 var(--display);color:#74805e}.panel-controls button{border:0;background:transparent;color:#5f6d50;font-size:28px;line-height:1;padding:5px 10px}.evidence-reader{overflow:auto;overscroll-behavior:contain;padding:30px 38px 35px;min-height:0}.panel-footer{display:flex;justify-content:space-between;gap:15px;align-items:center;padding:15px 30px;border-top:1px solid #ccd0b0;background:#e2e6c9;font-size:11px;color:#7c8460}.panel-footer button{border:0;background:transparent;font-size:12px;color:#3c5a42;padding:5px}.panel-footer kbd{border-color:#a4b28b;color:#52694b;margin-left:10px;font-size:10px}
  @media(max-width:900px),(pointer:coarse){.touch-controls{display:flex}.keyboard-help{display:none}.game-toolbar{justify-content:space-between}}
  @media(max-width:600px){.game-header{padding:12px 17px}.game-header h1{font-size:6px}.game-header .brand>span:last-child{display:none}.game-header nav{font-size:12px;gap:15px}.game-toolbar{padding:12px 15px;gap:15px}.nearby-button{font-size:11px;gap:8px;padding:8px}.exhibit-directory{min-width:92px}.exhibit-directory summary{padding:10px;font-size:11px}.game-caption{padding:5px 15px;font-size:9px}.game-caption span{display:none}.evidence-backdrop{padding:22px 12px}.evidence-paper{margin:0 8px;max-height:calc(100svh - 90px)}.panel-controls{padding:12px 15px}.panel-controls>span{font-size:5px}.evidence-reader{padding:22px}.panel-footer{padding:12px 15px}.panel-footer button{font-size:11px}.touch-controls{left:12px;right:12px;bottom:12px}.touch-controls button{width:42px;height:42px}.dpad{grid-template-columns:repeat(3,42px);grid-template-rows:repeat(3,42px)}}
</style>

